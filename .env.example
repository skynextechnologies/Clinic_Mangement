# Application
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
PORT=4000

# Database
DATABASE_URL=postgresql://clinicos:clinicos_dev_pass@localhost:5432/clinicos?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Auth & Encryption
JWT_ACCESS_SECRET=dev_jwt_access_secret_change_in_prod_32chars!
JWT_REFRESH_SECRET=dev_jwt_refresh_secret_change_in_prod_32chars!
ACCESS_TTL=15m
REFRESH_TTL=7d
COOKIE_DOMAIN=localhost
FIELD_ENCRYPTION_KEY=c3VwZXJzZWNyZXRkZXZrZXkxMjM0NTY3ODkwMTIzNDU9

# Storage (S3 / MinIO)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=clinicos-files
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Email (SMTP / Mailpit)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ClinicOS <noreply@clinicos.local>"

# Providers (Defaults)
SMS_PROVIDER=console
PAYMENT_PROVIDER=stripe_test
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# System Defaults
DEFAULT_TIMEZONE=UTC
DEFAULT_CURRENCY=USD
